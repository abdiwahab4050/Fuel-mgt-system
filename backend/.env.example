# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this server (used for payment callback/return URLs)
APP_URL=http://localhost:4000
# IANA time zone that defines the station's business day ("today", daily reports)
APP_TIMEZONE=Africa/Mogadishu

# ─── Database (PostgreSQL) ────────────────────────────────
# Hosted Postgres (Neon / Supabase): use the POOLED url for DATABASE_URL
# and the DIRECT (non-pooled) url for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ─── Auth / sessions ──────────────────────────────────────
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set true behind HTTPS in production
COOKIE_SECURE=false

# ─── Seeding ──────────────────────────────────────────────
# First super administrator (created by `npm run db:seed` if missing)
SEED_ADMIN_EMAIL=admin@fuelflow.com
SEED_ADMIN_PASSWORD=change-me-now
# true = also load demo stations, tanks, pumps, customers, sales (never in production)
SEED_DEMO_DATA=true

# ─── Payments ─────────────────────────────────────────────
# "sandbox" = built-in dev simulator (refused when NODE_ENV=production)
# "live"    = real provider adapter; requires the credentials below
PAYMENT_MODE=sandbox
# Pending electronic payments are cancelled after this many minutes without confirmation
PAYMENT_PENDING_TIMEOUT_MINUTES=15
# Optional fixed secret for sandbox webhook signatures (random per process when empty)
SANDBOX_WEBHOOK_SECRET=

# Live provider adapters are NOT implemented yet: they need each provider's official merchant
# API documentation. Filling in the variables below alone does not enable live payments.
# GET /api/payments/providers/status (Super Administrator) lists what is missing.
# Webhook URLs to register with providers: <APP_URL>/api/webhooks/zaad | edahab | mastercard

# ZAAD (Telesom) — obtain merchant API docs + credentials from Telesom / your acquiring partner
ZAAD_API_BASE_URL=
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
ZAAD_WEBHOOK_SECRET=

# eDAHAB (Dahabshiil) — obtain merchant API docs + credentials from eDahab
EDAHAB_API_BASE_URL=
EDAHAB_API_KEY=
EDAHAB_SECRET=
EDAHAB_AGENT_CODE=
EDAHAB_WEBHOOK_SECRET=

# Mastercard — via your acquiring bank's hosted checkout (e.g. Mastercard Payment Gateway Services)
MASTERCARD_GATEWAY_BASE_URL=
MASTERCARD_MERCHANT_ID=
MASTERCARD_API_PASSWORD=
MASTERCARD_WEBHOOK_SECRET=
