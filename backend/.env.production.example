# FuelFlow — PRODUCTION settings. Copy to backend/.env.production and fill in.
# Never commit the filled-in file. The server refuses to start if the
# security-critical values below are missing or unsafe.

NODE_ENV=production
PORT=4000
# Public HTTPS address of the site (required to be https:// in production)
APP_URL=https://fuel.example.com
APP_TIMEZONE=Africa/Mogadishu

# PostgreSQL — must be a UTF8 database.
# Use the LIMITED app role here (see deploy/db-roles.sql), not the owner account.
DATABASE_URL="postgresql://fuelflow_app:CHANGE_ME@db:5432/fuelflow?sslmode=disable"
# Migrations need the owner role
DIRECT_URL="postgresql://fuelflow_owner:CHANGE_ME@db:5432/fuelflow?sslmode=disable"

SESSION_TTL_HOURS=12
# Required in production (cookies only travel over HTTPS)
COOKIE_SECURE=true

# First super administrator — created by `npm run db:seed` if missing.
# Use a long unique password (12+ characters), sign in, then change it.
SEED_ADMIN_EMAIL=owner@yourstation.com
SEED_ADMIN_PASSWORD=
# Never load demo data in production
SEED_DEMO_DATA=false

# Payments: "live" is required in production. Live adapters must be implemented
# and credentials supplied before ZAAD / eDAHAB / Mastercard become available
# (see backend/PAYMENTS.md). Until then those methods are shown as unavailable;
# cash, bank transfer and credit accounts work normally.
PAYMENT_MODE=live
PAYMENT_PENDING_TIMEOUT_MINUTES=15

ZAAD_API_BASE_URL=
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
ZAAD_WEBHOOK_SECRET=

EDAHAB_API_BASE_URL=
EDAHAB_API_KEY=
EDAHAB_SECRET=
EDAHAB_AGENT_CODE=
EDAHAB_WEBHOOK_SECRET=

MASTERCARD_GATEWAY_BASE_URL=
MASTERCARD_MERCHANT_ID=
MASTERCARD_API_PASSWORD=
MASTERCARD_WEBHOOK_SECRET=
