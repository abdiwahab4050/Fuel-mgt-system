{
  "name": "fuelflow-backend",
  "version": "0.2.0",
  "private": true,
  "description": "FuelFlow ERP API — Express + Prisma + PostgreSQL. Serves the ../frontend app.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "7.3.2"
  }
}
